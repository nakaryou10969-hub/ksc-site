# microCMS
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key
MICROCMS_TOPIC_ENDPOINT=news

# Dedicated preview runtime. Use the existing microCMS read key above.
# Keep credentials out of git; inject these values through the approved host.
PREVIEW_BASIC_USERNAME=
PREVIEW_BASIC_PASSWORD=
PREVIEW_PUBLIC_ORIGIN=
# Local-only defaults. Remote hosting requires an approved TLS private ingress.
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=3001
